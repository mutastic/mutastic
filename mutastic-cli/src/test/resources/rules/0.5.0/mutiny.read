changed=selection removed
descriptors=[]
explanation=A selection on a Multi lets every item through, as if `where`, `distinct` or `first` weren't there. It goes unnoticed when no test has an item the selection must leave out.
id=mutiny/remove-selection
methods=[distinct, first, where]
owners=[io.smallrye.mutiny.groups.MultiSelect]
rewrite=call first(J) with Long.MAX_VALUE
since=0
source=first(Long.MAX_VALUE)
templates={headline=no test needs `.select().{name}(…)` in {method}, headline.distinct=no test has duplicate items for `.select().distinct()` in {method} to remove, headline.first=no test has more items than `.select().first(…)` in {method} lets through, help=add a test with an item the selection must leave out, and assert it's gone}
tier=defaults

changed=recovery removed, so the failure propagates
descriptors=[]
explanation=A recovery from failure is removed, so the failure goes on downstream. It goes unnoticed when no test makes the upstream fail.
id=mutiny/remove-recovery
methods=[recoverWithCompletion, recoverWithItem, recoverWithMulti, recoverWithNull, recoverWithUni]
owners=[io.smallrye.mutiny.groups.MultiOnFailure, io.smallrye.mutiny.groups.UniOnFailure]
rewrite=call transform(Ljava/util/function/Function;) with java.util.function.Function.identity()
since=0
source=transform(Function.identity())
templates={headline=no test makes {method} fail, so `.onFailure().{name}(…)` is never needed, help=add a test where the upstream fails, and assert what {method} gives instead}
tier=defaults
