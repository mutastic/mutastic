---
// The command reference, written from commands.json: the CLI's own declarations of its commands
// and options (./gradlew :mutastic-cli:exportDocsModel), the same ones `mutastic --help` prints.
// Each option shows how each runner writes it: the command line, Maven and Gradle.
import { Code } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import model from '../../data/commands.json';

type Command = (typeof model.commands)[number];
type Option = (typeof model.options)[number];

export function getStaticPaths() {
  return [
    ...model.commands.map((command) => ({ params: { page: command.name }, props: { command } })),
    { params: { page: 'environment' }, props: { command: undefined } },
  ];
}

const { command } = Astro.props as { command?: Command };
const options: Option[] = command
  ? command.options.map((name) => model.options.find((option) => option.name === name)!)
  : [];
const anchor = (option: Option) => option.name.replace(/^--/, '');

/** `=N`, `=MODULE,…`, `=false`: the value a property takes on the command line. */
function propertyValue(option: Option): string {
  if (option.name.startsWith('--no-')) return '=false';
  if (option.kind === 'flag') return '';
  if (option.kind === 'repeated') return `=${option.value},…`;
  return `=${option.value}`;
}

/** `mvn mutastic:verify -Dmutastic.mutant=ID`: how a build plugin runs the command. */
function runAs(command: Command, runner: 'maven' | 'gradle'): string {
  const name = command.name;
  const property = runner === 'maven' ? '-Dmutastic.' : '-Pmutastic.';
  const words =
    runner === 'maven'
      ? ['mvn', `mutastic:${name}`]
      : ['./gradlew', `mutastic${name[0].toUpperCase()}${name.slice(1)}`];
  if (command.takesMutantId) words.push(`${property}mutant=ID`);
  if (name === 'ignore') words.push(`${property}reason=WHY`);
  return words.join(' ');
}

const title = command ? `mutastic ${command.name}` : 'Environment and exit codes';
const description = command
  ? command.summary
  : 'The environment variables mutastic reads, and what its exit status means.';
const headings = command
  ? [
      { depth: 2, slug: 'usage', text: 'Usage' },
      { depth: 2, slug: 'examples', text: 'Examples' },
      { depth: 2, slug: 'from-maven-and-gradle', text: 'From Maven and Gradle' },
      ...(options.length ? [{ depth: 2, slug: 'options', text: 'Options' }] : []),
      ...options.map((option) => ({ depth: 3, slug: anchor(option), text: option.name })),
    ]
  : [
      { depth: 2, slug: 'environment', text: 'Environment' },
      { depth: 2, slug: 'exit-codes', text: 'Exit codes' },
    ];
---

<StarlightPage frontmatter={{ title, description }} headings={headings}>
  {
    command ? (
      <>
        <p>{command.summary}. {command.detail}</p>
        <h2 id="usage">Usage</h2>
        <Code code={command.synopsis} lang="sh" />
        <h2 id="examples">Examples</h2>
        <Code code={command.examples.join('\n')} lang="sh" />
        <h2 id="from-maven-and-gradle">From Maven and Gradle</h2>
        <p>
          The build plugins run the same command, with each option as a <code>mutastic.</code>{' '}
          property of the same name.
        </p>
        <Code code={`${runAs(command, 'maven')}\n${runAs(command, 'gradle')}`} lang="sh" />
        {options.length > 0 && <h2 id="options">Options</h2>}
        {options.map((option) => (
          <section>
            <h3 id={anchor(option)} class="option-heading">
              <code>{option.synopsis}</code>
            </h3>
            <p>{option.help}.</p>
            {option.choices.length > 0 && (
              <p class="choices">
                One of {option.choices.map((choice) => <code>{choice}</code>)}
              </p>
            )}
            <table class="runners">
              <tbody>
                <tr>
                  <th scope="row">Command line</th>
                  <td>
                    <code>{option.synopsis}</code>
                  </td>
                </tr>
                {option.maven && (
                  <tr>
                    <th scope="row">Maven</th>
                    <td>
                      <code>{option.maven.property + propertyValue(option)}</code>
                      {option.maven.setting && (
                        <>
                          {' '}or <code>{option.maven.setting}</code> in the plugin's configuration
                        </>
                      )}
                    </td>
                  </tr>
                )}
                {option.gradle && (
                  <tr>
                    <th scope="row">Gradle</th>
                    <td>
                      <code>{option.gradle.property + propertyValue(option)}</code>
                      {option.gradle.setting && (
                        <>
                          {' '}or <code>{option.gradle.setting}</code> in <code>mutastic {'{ }'}</code>
                        </>
                      )}
                    </td>
                  </tr>
                )}
                {option.environment && (
                  <tr>
                    <th scope="row">Environment</th>
                    <td>
                      <code>{option.environment}</code>
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </section>
        ))}
      </>
    ) : (
      <>
        <h2 id="environment">Environment</h2>
        <table>
          <tbody>
            {model.environment.map((entry) => (
              <tr>
                <th scope="row">
                  <code>{entry.name}</code>
                </th>
                <td>{entry.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <h2 id="exit-codes">Exit codes</h2>
        <table>
          <tbody>
            {model.exitCodes.map((entry) => (
              <tr>
                <th scope="row">
                  <code>{entry.name}</code>
                </th>
                <td>{entry.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>
          The build plugins fail the build on any status but 0. See{' '}
          <a href="/guides/troubleshooting/">Troubleshooting</a> for what to do about each.
        </p>
      </>
    )
  }
</StarlightPage>
