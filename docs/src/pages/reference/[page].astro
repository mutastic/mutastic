---
// The Java edition's command reference, written from commands.json: the CLI's own declarations of
// its commands and options (./gradlew :mutastic-cli:exportDocsModel), the same ones
// `mutastic --help` prints. The page itself is components/CommandReference.astro, which the Rust
// edition's pages share.
import CommandReference from '../../components/CommandReference.astro';
import model from '../../data/commands.json';

/**
 * What a command prints, where the docs show it: mutastic's own output on the pricing sample,
 * written by ./gradlew :mutastic-cli:exportDocsOutput and checked against the CLI by
 * DocsOutputTest, which runs the quickstart's tour. `explain.ansi` is `mutastic explain`'s.
 */
const outputs = import.meta.glob<string>('../../data/output/*.ansi', {
  query: '?raw',
  import: 'default',
  eager: true,
});

type Command = (typeof model.commands)[number];

export function getStaticPaths() {
  return [
    ...model.commands.map((command) => ({ params: { page: command.page }, props: { command } })),
    { params: { page: 'environment' }, props: { command: undefined } },
  ];
}

const { command } = Astro.props as { command?: Command };
const output = command ? outputs[`../../data/output/${command.page}.ansi`] : undefined;
---

<CommandReference model={model} command={command} output={output} edition="java" />
