---
// The command reference, written from commands.json: the CLI's own declarations of its commands
// and options (./gradlew :mutastic-cli:exportDocsModel), the same ones `mutastic --help` prints,
// with each example as each runner writes it. Each section is a row: what it does on the left, and
// on the right its examples, pinned while the row scrolls by, in Gradle, Maven and command-line
// tabs that follow the reader's choice across the site. On a narrow screen the examples follow the
// prose.
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import model from '../../data/commands.json';

/**
 * What a command prints, where the docs show it: mutastic's own output on the pricing sample,
 * written by ./gradlew :mutastic-cli:exportDocsOutput and checked against the CLI by
 * DocsOutputTest, which runs the quickstart's tour. `explain.ansi` is `mutastic explain`'s.
 */
const outputs = import.meta.glob<string>('../../data/output/*.ansi', {
  query: '?raw',
  import: 'default',
  eager: true,
});

type Command = (typeof model.commands)[number];
type Option = (typeof model.options)[number];

export function getStaticPaths() {
  return [
    ...model.commands.map((command) => ({ params: { page: command.name }, props: { command } })),
    { params: { page: 'environment' }, props: { command: undefined } },
  ];
}

const { command } = Astro.props as { command?: Command };
const options: Option[] = command
  ? command.options.map((name) => model.options.find((option) => option.name === name)!)
  : [];
const anchor = (option: Option) => option.name.replace(/^--/, '');
const output = command ? outputs[`../../data/output/${command.name}.ansi`] : undefined;

/** When in the quickstart's tour each output was taken, as DocsOutputTest takes it. */
const when: Record<string, string> = {
  run: 'On the pricing sample, where one mutant gets past the tests.',
  explain: 'On the pricing sample, after a run.',
  verify: 'On the pricing sample, once the test the card suggested is added.',
};

/** `=N`, `=MODULE,…`, `=false`: the value a property takes on the command line. */
function propertyValue(option: Option): string {
  if (option.name.startsWith('--no-')) return '=false';
  if (option.kind === 'flag') return '';
  if (option.kind === 'repeated') return `=${option.value},…`;
  return `=${option.value}`;
}

/**
 * `./gradlew mutasticRun -Pmutastic.threshold=70 -p app` as a shell would take it on several
 * lines: the command and its first word, then one argument per line after a `\`. A narrow column
 * then never breaks a command in the middle of an option. Short commands stay on one line.
 */
function continued(command: string): string {
  const words = command.match(/(?:[^\s"]+|"[^"]*")+/g) ?? [command];
  if (command.length <= 36 || words.length <= 2) return command;
  const lines = [words.slice(0, 2).join(' ')];
  for (let index = 2; index < words.length; index++) {
    const word = words[index];
    // A flag and its value, `-p app`, stay together.
    if (['-p', '-f', '-pl'].includes(word) && index + 1 < words.length) {
      lines.push(`${word} ${words[++index]}`);
    } else {
      lines.push(word);
    }
  }
  return lines.join(' \\\n  ');
}

const title = command ? `mutastic ${command.name}` : 'Environment and exit codes';
const description = command
  ? command.summary
  : 'The environment variables mutastic reads, and what its exit status means.';
const headings = command
  ? [
      { depth: 2, slug: 'usage', text: 'Usage' },
      ...(output ? [{ depth: 2, slug: 'output', text: 'Output' }] : []),
      ...(options.length ? [{ depth: 2, slug: 'options', text: 'Options' }] : []),
      ...options.map((option) => ({ depth: 3, slug: anchor(option), text: option.name })),
    ]
  : [
      { depth: 2, slug: 'environment', text: 'Environment' },
      { depth: 2, slug: 'exit-codes', text: 'Exit codes' },
    ];
---

<StarlightPage frontmatter={{ title, description }} headings={headings}>
  {
    command ? (
      <div class="reference">
        <section class="reference-row">
          <div class="reference-prose">
            <p>
              {command.summary}. {command.detail}
            </p>
            <h2 id="usage">Usage</h2>
            <Code code={command.synopsis} lang="sh" wrap />
            <p>
              The build plugins run the same command, with each option as a{' '}
              <code>mutastic.</code> property of the same name.
            </p>
          </div>
          <aside class="reference-examples" aria-label="Examples">
            <Tabs syncKey="runner">
              <TabItem label="Gradle">
                <Code code={command.examples.map((example) => continued(example.gradle)).join('\n')} lang="sh" wrap />
              </TabItem>
              <TabItem label="Maven">
                <Code code={command.examples.map((example) => continued(example.maven)).join('\n')} lang="sh" wrap />
              </TabItem>
              <TabItem label="Command line">
                <Code
                  code={command.examples.map((example) => continued(example.commandLine)).join('\n')}
                  lang="sh"
                  wrap
                />
              </TabItem>
            </Tabs>
          </aside>
        </section>
        {output && (
          <section class="reference-output">
            <h2 id="output">Output</h2>
            <p>
              {when[command.name]} This is mutastic's own output, written from the CLI and checked
              against it on every build.
            </p>
            <Code code={output} lang="ansi" />
          </section>
        )}
        {options.length > 0 && <h2 id="options">Options</h2>}
        {options.map((option) => (
          <section class="reference-row">
            <div class="reference-prose">
              <h3 id={anchor(option)} class="option-heading">
                <code>{option.synopsis}</code>
              </h3>
              <p>{option.help}.</p>
              {option.choices.length > 0 && (
                <p class="choices">
                  One of {option.choices.map((choice) => <code>{choice}</code>)}
                </p>
              )}
              <table class="runners">
                <tbody>
                  {option.gradle && (
                    <tr>
                      <th scope="row">Gradle</th>
                      <td>
                        <code>{option.gradle.property + propertyValue(option)}</code>
                        {option.gradle.setting && (
                          <>
                            {' '}or <code>{option.gradle.setting}</code> in{' '}
                            <code>mutastic {'{ }'}</code>
                          </>
                        )}
                      </td>
                    </tr>
                  )}
                  {option.maven && (
                    <tr>
                      <th scope="row">Maven</th>
                      <td>
                        <code>{option.maven.property + propertyValue(option)}</code>
                        {option.maven.setting && (
                          <>
                            {' '}or <code>{option.maven.setting}</code> in the plugin's
                            configuration
                          </>
                        )}
                      </td>
                    </tr>
                  )}
                  <tr>
                    <th scope="row">Command line</th>
                    <td>
                      <code>{option.synopsis}</code>
                    </td>
                  </tr>
                  {option.environment && (
                    <tr>
                      <th scope="row">Environment</th>
                      <td>
                        <code>{option.environment}</code>
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
            <aside class="reference-examples" aria-label={`Example of ${option.name}`}>
              <Tabs syncKey="runner">
                <TabItem label="Gradle">
                  <Code code={continued(option.examples.gradle)} lang="sh" wrap />
                  {option.examples.gradleBuild && (
                    <Code code={option.examples.gradleBuild} lang="kotlin" title="build.gradle.kts" wrap />
                  )}
                </TabItem>
                <TabItem label="Maven">
                  <Code code={continued(option.examples.maven)} lang="sh" wrap />
                  {option.examples.mavenBuild && (
                    <Code code={option.examples.mavenBuild} lang="xml" title="pom.xml" wrap />
                  )}
                </TabItem>
                <TabItem label="Command line">
                  <Code code={continued(option.examples.commandLine)} lang="sh" wrap />
                </TabItem>
              </Tabs>
            </aside>
          </section>
        ))}
      </div>
    ) : (
      <>
        <h2 id="environment">Environment</h2>
        <table>
          <tbody>
            {model.environment.map((entry) => (
              <tr>
                <th scope="row">
                  <code>{entry.name}</code>
                </th>
                <td>{entry.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <h2 id="exit-codes">Exit codes</h2>
        <table>
          <tbody>
            {model.exitCodes.map((entry) => (
              <tr>
                <th scope="row">
                  <code>{entry.name}</code>
                </th>
                <td>{entry.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>
          The build plugins fail the build on any status but 0. See{' '}
          <a href={`${import.meta.env.BASE_URL}guides/troubleshooting/`}>Troubleshooting</a> for what
          to do about each.
        </p>
      </>
    )
  }
</StarlightPage>
