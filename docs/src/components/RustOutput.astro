---
// A block of the Rust edition's captured output, by its name in mutastic-rs's docs/output/
// (`concepts/format-concise`), in the colour mutastic printed it. mutastic-rs's docs test keeps
// each one true to what mutastic prints; scripts/rust-docs.mjs copies them to
// src/data/rust/captures/, so a page here shows that output, never a copy of its text. Without
// the Rust edition's pages it shows nothing, as the Rust side of a page isn't shown then, nor on a
// page still waiting for its Rust side (AWAITING_RUST in src/edition-pages.mjs), whose output the
// pinned release hasn't got yet.
import { Aside, Code } from '@astrojs/starlight/components';
import pin from '../../rust-edition.json';
import { awaitsRust } from '../lib/awaiting-rust';
import type { EditionPanes } from '../route-editions';

interface Props {
  name: string;
  /** Wrap long lines, as the agent format's are, rather than scroll them. */
  wrap?: boolean;
  /** Only the output before the first line that starts with this, as `     Files` for a card. */
  until?: string;
  /**
   * The pinned Rust release this output comes after, `v1.1.0`, on a page whose Rust side is
   * otherwise there: while docs/rust-edition.json still pins it, a note stands in for the output.
   * Once the pin moves on, the build says to take it out.
   */
  awaiting?: string;
}
const { name, wrap = false, until, awaiting } = Astro.props;

const captures = import.meta.glob<string>('../data/rust/captures/**/*.{ansi,txt}', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const rust = (Astro.locals as { editionPanes?: EditionPanes }).editionPanes !== undefined;
const at = (kind: string) => captures[`../data/rust/captures/${name}.${kind}`];
const whole = at('ansi') ?? at('txt');
const plainLine = (line: string) => line.replace(/\x1b\[[0-9;]*m/g, '');
const cut = (all: string) => {
  const lines = all.split('\n');
  const end = lines.findIndex((line) => plainLine(line).startsWith(until!));
  return end < 0 ? all : `${lines.slice(0, end).join('\n').replace(/\n+$/, '')}\n`;
};
const text = whole !== undefined && until !== undefined ? cut(whole) : whole;
const pinned = `v${pin.version}`;
if (awaiting !== undefined && awaiting !== pinned) {
  throw new Error(`RustOutput '${name}' awaits the Rust release after ${awaiting}, and the pin is ${pinned} now: take out its awaiting`);
}
const waiting = text === undefined && awaiting !== undefined;
if (rust && text === undefined && !awaitsRust(Astro.locals) && !waiting) {
  throw new Error(`No Rust output named '${name}': mutastic-rs's docs/output/${name}.ansi isn't there`);
}
---

{text !== undefined && <Code code={text.replace(/\n$/, '')} lang="ansi" wrap={wrap} />}
{rust && waiting && <Aside>This output comes with mutastic for Rust's next release.</Aside>}
