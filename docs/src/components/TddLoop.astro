---
// The test-first cycle with mutastic in it, as a diagram: red, green, then mutastic's two steps
// (mutate, and the card's test proved with `verify`), then refactor and commit, which starts the
// next cycle. A card's test that fails on today's code has found a bug, and goes back to green.
// Drawn in the theme's colours, so it reads in light and dark alike; the text says the same.
//
// Two drawings of the same cycle, with elbow arrows: a row where the page is wide, and a column
// where it's narrow, as on a phone, where the row would shrink its text past reading. The figure's
// own width picks one (a container query), and each has its own arrowhead, since a marker in a
// drawing that isn't shown isn't drawn in the other.
//
// With `current`, it's the guides' "you are here": that step stands out and the rest are dimmed,
// smaller, with no caption. Where it's narrow, a line of the steps' names takes the place of the
// column, which would otherwise stand six times down a phone's page.
//
//   <TddLoop />                     the whole cycle, with its caption (the concept page)
//   <TddLoop current="Mutate" />    the step a guide's section is at
//
// A page can hold several, so each takes its ids (arrowheads, title, desc) from a count kept on the
// page's render.
interface Props {
  current?: 'Red' | 'Green' | 'Mutate' | 'Triangulate' | 'Refactor' | 'Commit';
}
const { current } = Astro.props;
const compact = current !== undefined;

const steps = [
  { name: 'Red', note: 'a test fails', kind: 'red' },
  { name: 'Green', note: 'least code', kind: 'green' },
  { name: 'Mutate', note: 'run --since=HEAD', kind: 'mutastic' },
  { name: 'Triangulate', note: "card's test, verify", kind: 'mutastic' },
  { name: 'Refactor', note: 'structure only', kind: '' },
  { name: 'Commit', note: 'ends the cycle', kind: '' },
];
if (compact && !steps.some((step) => step.name === current)) {
  throw new Error(`TddLoop: no step named ${current}`);
}
const description =
  "Red: a test from the spec fails. Green: the least code that passes it. Mutate: mutastic runs on the cycle's lines. Triangulate: write each card's test and prove it with verify; one that fails on today's code has found a bug, back to green. Refactor, then commit, which starts the next cycle.";
const title = compact
  ? `Working test-first with mutastic: you are at ${current}`
  : 'Working test-first with mutastic';
const stepClass = (step: (typeof steps)[number]) => [
  'step',
  step.kind,
  compact && (step.name === current ? 'current' : 'dim'),
];

const locals = Astro.locals as { tddLoops?: number };
locals.tddLoops = (locals.tddLoops ?? 0) + 1;
const id = (part: string) => `tdd-loop-${locals.tddLoops}-${part}`;

// The row: each box's left edge and width, all 58 high from y 50.
const row = [
  [10, 105],
  [135, 105],
  [260, 115],
  [395, 125],
  [540, 95],
  [655, 95],
];
const rowMid = (i: number) => row[i][0] + row[i][1] / 2;

// The column: every box 170 wide from x 40, 46 high, 68 apart from y 10.
const colTop = (i: number) => 10 + i * 68;
---

<figure class:list={['tdd-loop', { compact }]}>
  <svg
    class="wide"
    viewBox="0 0 760 166"
    role="img"
    aria-labelledby={`${id('wide-title')} ${id('wide-desc')}`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={id('wide-title')}>{title}</title>
    <desc id={id('wide-desc')}>{description}</desc>
    <defs>
      <marker id={id('arrow-wide')} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" class="ink" />
      </marker>
    </defs>
    {
      steps.map((step, i) => (
        <g class:list={stepClass(step)}>
          <rect x={row[i][0]} y="50" width={row[i][1]} height="58" rx="8" />
          <text x={rowMid(i)} y="74">{step.name}</text>
          <text x={rowMid(i)} y="94" class="small">{step.note}</text>
        </g>
      ))
    }
    <g class="arrows">
      {
        row.slice(0, -1).map(([x, w], i) => (
          <line x1={x + w} y1="79" x2={row[i + 1][0] - 2} y2="79" marker-end={`url(#${id('arrow-wide')})`} />
        ))
      }
      <path d="M457,50 V32 Q457,26 451,26 H193 Q187,26 187,32 V48" class="back" marker-end={`url(#${id('arrow-wide')})`} />
      <path d="M702,108 V130 Q702,136 696,136 H68 Q62,136 62,130 V110" marker-end={`url(#${id('arrow-wide')})`} />
    </g>
    <text x="322" y="16" class="note">red on today's code: a bug, back to green</text>
    <text x="382" y="156" class="note">the next cycle starts from the commit</text>
  </svg>

  {
    compact ? (
      <ol class="stepper" aria-label={title}>
        {steps.map((step) => (
          <li class:list={[step.kind, { current: step.name === current }]} aria-current={step.name === current ? 'step' : undefined}>
            {step.name}
          </li>
        ))}
      </ol>
    ) : (
      <svg
        class="narrow"
        viewBox="0 0 400 452"
        role="img"
        aria-labelledby={`${id('narrow-title')} ${id('narrow-desc')}`}
        xmlns="http://www.w3.org/2000/svg"
      >
        <title id={id('narrow-title')}>{title}</title>
        <desc id={id('narrow-desc')}>{description}</desc>
        <defs>
          <marker id={id('arrow-narrow')} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
            <path d="M0,0 L10,5 L0,10 z" class="ink" />
          </marker>
        </defs>
        {steps.map((step, i) => (
          <g class:list={stepClass(step)}>
            <rect x="40" y={colTop(i)} width="170" height="46" rx="8" />
            <text x="125" y={colTop(i) + 20}>{step.name}</text>
            <text x="125" y={colTop(i) + 37} class="small">{step.note}</text>
          </g>
        ))}
        <g class="arrows">
          {steps.slice(0, -1).map((_, i) => (
            <line x1="125" y1={colTop(i) + 46} x2="125" y2={colTop(i + 1) - 2} marker-end={`url(#${id('arrow-narrow')})`} />
          ))}
          <path d="M210,237 H234 Q240,237 240,231 V107 Q240,101 234,101 H212" class="back" marker-end={`url(#${id('arrow-narrow')})`} />
          <path d="M125,396 V412 Q125,418 119,418 H24 Q18,418 18,412 V39 Q18,33 24,33 H38" marker-end={`url(#${id('arrow-narrow')})`} />
        </g>
        <text x="252" y="163" class="note start">red on today's code:</text>
        <text x="252" y="179" class="note start">a bug, back to green</text>
        <text x="125" y="440" class="note">the next cycle starts from the commit</text>
      </svg>
    )
  }
  {
    !compact && (
      <figcaption>
        mutastic comes after green: a red suite stops it. A card's test passes on today's code and
        fails only with the mutant, so <code>verify</code> is its red and green.
      </figcaption>
    )
  }
</figure>

<style>
  .tdd-loop {
    margin: 1.5rem 0;
    container-type: inline-size;
  }
  .tdd-loop svg {
    width: 100%;
    height: auto;
  }
  .tdd-loop svg.wide {
    max-width: 760px;
  }
  .tdd-loop svg.narrow {
    display: none;
    max-width: 400px;
  }
  /* Below this the row's text would be smaller than 10px: the column takes its place. */
  @container (max-width: 560px) {
    .tdd-loop svg.wide {
      display: none;
    }
    .tdd-loop svg.narrow {
      display: block;
    }
  }
  .tdd-loop figcaption {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
  }
  .step rect {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .step text {
    fill: var(--sl-color-white);
    font-size: 15px;
    font-weight: 600;
    text-anchor: middle;
  }
  .step text.small {
    font-size: 11.5px;
    font-weight: 400;
    fill: var(--sl-color-gray-2);
  }
  .step.red rect {
    stroke: #d9534f;
  }
  .step.green rect {
    stroke: #5cb85c;
  }
  .step.mutastic rect {
    fill: var(--sl-color-accent-low);
    stroke: var(--sl-color-accent);
  }
  .arrows line,
  .arrows path {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
    fill: none;
  }
  .arrows .back {
    stroke-dasharray: 5 4;
  }
  .ink {
    fill: var(--sl-color-gray-3);
  }
  .note {
    fill: var(--sl-color-gray-3);
    font-size: 11.5px;
    text-anchor: middle;
  }
  .note.start {
    text-anchor: start;
  }

  /* The guides' "you are here": smaller, the current step outlined, the rest dimmed. */
  .tdd-loop.compact {
    margin: 0.75rem 0 1rem;
  }
  .tdd-loop.compact svg.wide {
    max-width: 640px;
  }
  .step.dim {
    opacity: 0.45;
  }
  .step.current rect {
    stroke-width: 3.5;
    stroke: var(--sl-color-white);
  }
  .step.current.red rect {
    fill: color-mix(in srgb, #d9534f 18%, var(--sl-color-gray-6));
    stroke: #d9534f;
  }
  .step.current.green rect {
    fill: color-mix(in srgb, #5cb85c 18%, var(--sl-color-gray-6));
    stroke: #5cb85c;
  }
  .step.current.mutastic rect {
    stroke: var(--sl-color-accent);
  }
  .compact .note {
    opacity: 0.7;
  }
  .stepper {
    display: none;
  }
  /* Where the row would be too small to read, the steps' names in a line, the current one marked. */
  @container (max-width: 560px) {
    .tdd-loop.compact .stepper {
      display: flex;
    }
  }
  .tdd-loop .stepper {
    flex-wrap: wrap;
    gap: 0.15rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .tdd-loop .stepper li {
    margin: 0;
    padding: 0;
  }
  /* After the name, so a line that wraps ends on the arrow and starts on a step. */
  .tdd-loop .stepper li:not(:last-child)::after {
    content: '›' / '';
    padding: 0 0.4em;
    color: var(--sl-color-gray-4);
    font-weight: 400;
  }
  .tdd-loop .stepper li.current {
    color: var(--sl-color-white);
    font-weight: 700;
  }
  /* The outlines' red and green, a shade darker or lighter, to read as text on either theme. */
  .tdd-loop .stepper li.current.red {
    color: #e8706c;
  }
  .tdd-loop .stepper li.current.green {
    color: #6cc96c;
  }
  :global([data-theme='light']) .tdd-loop .stepper li.current.red {
    color: #b52b27;
  }
  :global([data-theme='light']) .tdd-loop .stepper li.current.green {
    color: #2e7d32;
  }
  .tdd-loop .stepper li.current.mutastic {
    color: var(--sl-color-text-accent);
  }
</style>
