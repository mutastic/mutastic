---
// Above every page of docs that aren't the latest release's: main's, which describe what isn't
// released yet, and an older release's. Then any banner the page asks for itself.
import Default from '@astrojs/starlight/components/Banner.astro';
import { home, latest, pageWithin, version } from './versions';

const page = pageWithin(Astro.url.pathname);
const message =
  version === 'next'
    ? `These docs describe main, which isn't released yet.`
    : version !== '' && latest !== '' && version !== latest
      ? `These are the docs for mutastic ${version}. The latest release is ${latest}.`
      : '';
---

{
  message && (
    <div class="version-banner" role="note">
      {message} <a href={home(latest) + page}>Read this page for the latest release</a>.
    </div>
  )
}
<Default />

<style>
  .version-banner {
    padding: 0.6rem var(--sl-nav-pad-x, 1rem);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
  .version-banner a {
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }
</style>
