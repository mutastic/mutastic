---
// The page's title, with the edition it belongs to above it, once the site has more than one, so
// a page reached from search or a link says which edition it describes.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import type { EditionPanes } from '../route-editions';

const panes = (Astro.locals as { editionPanes?: EditionPanes }).editionPanes;
const edition = panes?.edition;
---

{
  edition && edition !== 'shared' && (
    <p class="edition-chip" data-edition={edition}>
      {edition === 'rust' ? 'Rust edition' : 'Java edition'}
    </p>
  )
}
<Default />

<style>
  .edition-chip {
    display: inline-block;
    margin: 0 0 0.5rem;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }
</style>
