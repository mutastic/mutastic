---
// Java or Rust, at the top of the sidebar. Choosing the other edition opens the same topic there
// when it has one, or its overview, saying so first, when it doesn't. On a page both editions
// share it swaps the sidebar, and the page's edition tabs, in place. The choice is remembered in
// this browser.
import type { EditionPanes } from '../route-editions';

interface Props {
  panes: EditionPanes;
}
const { panes } = Astro.props;
const shared = panes.edition === 'shared';
const other = panes.edition === 'java' ? 'rust' : panes.edition === 'rust' ? 'java' : undefined;
const note = other ? panes.links[other].note : undefined;
const sides = [
  { edition: 'java', label: 'Java', sub: 'and Kotlin' },
  { edition: 'rust', label: 'Rust', sub: 'Cargo' },
] as const;
---

<div class="edition-switch" role="group" aria-label="Edition">
  <span class="thumb" aria-hidden="true"></span>
  {
    sides.map(({ edition, label, sub }) => {
      const link = panes.links[edition];
      const current = panes.edition === edition;
      return (
        <a
          href={link.href}
          data-edition={edition}
          data-inplace={shared ? '' : undefined}
          aria-current={current ? 'page' : undefined}
          title={link.note}
        >
          <span class="label">{label}</span>
          <span class="sub">{sub}</span>
        </a>
      );
    })
  }
</div>
{note && <p class="switch-note">{panes.edition === 'java' ? 'No Rust page on this topic yet: Rust opens at its overview.' : 'No Java page on this topic: Java opens at its overview.'}</p>}

<script>
  // The switch and a page's edition tabs (Starlight's, synced by the key `edition`) are one choice:
  // choosing an edition in either shows it in both, and both are remembered in this browser.
  type Edition = 'java' | 'rust';
  const LABELS: Record<Edition, string> = { java: 'Java', rust: 'Rust' };
  const TABS = 'starlight-tabs[data-sync-key="edition"]';
  const inPlace = document.querySelector('.edition-switch a[data-inplace]') !== null;

  function remember(edition: Edition) {
    try {
      localStorage.setItem('mutastic-edition', edition);
      localStorage.setItem('starlight-synced-tabs__edition', LABELS[edition]);
    } catch {}
  }

  /** Opens each edition tab group on the page at `edition`, as Starlight restores a synced tab. */
  function showTabs(edition: Edition) {
    for (const group of document.querySelectorAll<HTMLElement>(TABS)) {
      const tabs = [...group.querySelectorAll<HTMLElement>(':scope > .tablist-wrapper [role="tab"]')];
      const panels = [...group.querySelectorAll<HTMLElement>(':scope > [role="tabpanel"]')];
      const at = tabs.findIndex((tab) => tab.textContent?.trim() === LABELS[edition]);
      if (at === -1) continue;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === at));
        if (i === at) tab.removeAttribute('tabindex');
        else tab.setAttribute('tabindex', '-1');
      });
      panels.forEach((panel, i) => (panel.hidden = i !== at));
    }
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('.edition-switch a')) {
    link.addEventListener('click', (event) => {
      const edition = link.dataset.edition as Edition;
      remember(edition);
      if (link.hasAttribute('data-inplace')) {
        event.preventDefault();
        document.documentElement.dataset.edition = edition;
        showTabs(edition);
      }
    });
  }

  // A tab chosen on a shared page changes the sidebar too. Starlight has already switched the
  // page's other edition tabs and remembered the tab by the time this reads which is selected.
  const fromTabs = (event: Event) => {
    const tab = (event.target as Element | null)?.closest('[role="tab"]');
    const group = tab?.closest<HTMLElement>('starlight-tabs');
    if (group?.dataset.syncKey !== 'edition') return;
    setTimeout(() => {
      const label = group.querySelector(':scope > .tablist-wrapper [aria-selected="true"]')?.textContent?.trim();
      const edition = (Object.keys(LABELS) as Edition[]).find((e) => LABELS[e] === label);
      if (edition === undefined) return;
      remember(edition);
      if (inPlace) document.documentElement.dataset.edition = edition;
    });
  };
  document.addEventListener('click', fromTabs);
  document.addEventListener('keyup', fromTabs);
</script>

<style>
  .edition-switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    padding: 0.25rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
  }
  .thumb {
    position: absolute;
    inset: 0.25rem auto 0.25rem 0.25rem;
    width: calc(50% - 0.25rem);
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    box-shadow: inset 0 0 0 1px var(--sl-color-accent);
    transition: transform 180ms ease;
  }
  :global(:root[data-edition='rust']) .thumb {
    transform: translateX(100%);
  }
  a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.45rem 0.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--sl-color-gray-3);
    line-height: 1.15;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .label {
    font-weight: 700;
    font-size: var(--sl-text-base);
  }
  .sub {
    font-size: var(--sl-text-2xs, 0.7rem);
    opacity: 0.8;
  }
  :global(:root:not([data-edition='rust'])) a[data-edition='java'],
  :global(:root[data-edition='rust']) a[data-edition='rust'] {
    color: var(--sl-color-white);
  }
  .switch-note {
    margin: -0.75rem 0 1.25rem;
    padding: 0 0.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb {
      transition: none;
    }
  }
</style>
