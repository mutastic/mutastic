{
  "schema": "mutastic.commands/v1",
  "docs": "https://docs.mutastic.io/",
  "commands": [
    {
      "name": "run",
      "synopsis": "mutastic run [DIR] [:MODULE] [OPTIONS]",
      "summary": "Mutate the code and run its tests against each mutant",
      "detail": "DIR is the build, here unless given, and :MODULE one of its modules: as Gradle names it (:app), or as Maven's -pl takes it (:services/api). The run passes when the score reaches the threshold. A full run writes report files, keeps a record the next run compares with, and offers the commands to work on each missed mutant.",
      "takesMutantId": false,
      "examples": [{ "gradle": "./gradlew mutasticRun", "maven": "mvn mutastic:run", "commandLine": "mutastic run" }, { "gradle": "./gradlew mutasticRun -Pmutastic.threshold=70 -p samples/pricing", "maven": "mvn mutastic:run -Dmutastic.threshold=70 -f samples/pricing", "commandLine": "mutastic run samples/pricing --threshold=70" }, { "gradle": "./gradlew mutasticRun -Pmutastic.since=main", "maven": "mvn mutastic:run -Dmutastic.since=main", "commandLine": "mutastic run --since=main" }, { "gradle": "./gradlew :core:mutasticRun -Pmutastic.testsFrom=dependents", "maven": "mvn mutastic:run -Dmutastic.testsFrom=dependents -pl core", "commandLine": "mutastic run . :core --tests-from=dependents" }],
      "options": ["--threshold", "--since", "--only", "--tests-from", "--workers", "--confirm-catches", "--no-suggestions", "--operators", "--report", "--format", "--vocabulary", "--color", "--hyperlinks", "--progress"]
    },
    {
      "name": "verify",
      "synopsis": "mutastic verify ID [DIR] [:MODULE]",
      "summary": "Run one mutant's tests: it passes when they catch it",
      "detail": "How a fix is proved: each missed mutant offers it as \"done when\".",
      "takesMutantId": true,
      "examples": [{ "gradle": "./gradlew mutasticVerify -Pmutastic.mutant=m855c8e3c", "maven": "mvn mutastic:verify -Dmutastic.mutant=m855c8e3c", "commandLine": "mutastic verify m855c8e3c" }, { "gradle": "./gradlew mutasticVerify -Pmutastic.mutant=m855c8e3c -p samples/pricing", "maven": "mvn mutastic:verify -Dmutastic.mutant=m855c8e3c -f samples/pricing", "commandLine": "mutastic verify m855c8e3c samples/pricing" }],
      "options": ["--tests-from", "--workers", "--confirm-catches", "--progress"]
    },
    {
      "name": "explain",
      "synopsis": "mutastic explain ID [DIR] [:MODULE]",
      "summary": "Everything known of one mutant, with its tests run",
      "detail": "Its card, the change in its bytecode, what its operator does, and its result in the last full run.",
      "takesMutantId": true,
      "examples": [{ "gradle": "./gradlew mutasticExplain -Pmutastic.mutant=m855c8e3c", "maven": "mvn mutastic:explain -Dmutastic.mutant=m855c8e3c", "commandLine": "mutastic explain m855c8e3c" }],
      "options": ["--tests-from", "--workers", "--confirm-catches", "--no-suggestions", "--vocabulary", "--color", "--hyperlinks", "--progress"]
    },
    {
      "name": "ignore",
      "synopsis": "mutastic ignore ID [DIR] [:MODULE] --reason=WHY",
      "summary": "Record a decision not to test one mutant",
      "detail": "It goes in .mutastic/ignores.yaml with its line and the reason, to commit and review, and lapses when that line changes. --remove takes one back; ignore --prune takes away every one that has lapsed.",
      "takesMutantId": true,
      "examples": [{ "gradle": "./gradlew mutasticIgnore -Pmutastic.mutant=m855c8e3c -Pmutastic.reason=\"only logs\"", "maven": "mvn mutastic:ignore -Dmutastic.mutant=m855c8e3c -Dmutastic.reason=\"only logs\"", "commandLine": "mutastic ignore m855c8e3c --reason=\"only logs\"" }, { "gradle": "./gradlew mutasticIgnore -Pmutastic.mutant=m855c8e3c -Pmutastic.remove", "maven": "mvn mutastic:ignore -Dmutastic.mutant=m855c8e3c -Dmutastic.remove", "commandLine": "mutastic ignore --remove m855c8e3c" }, { "gradle": "./gradlew mutasticIgnore -Pmutastic.prune", "maven": "mvn mutastic:ignore -Dmutastic.prune", "commandLine": "mutastic ignore --prune" }],
      "options": ["--reason", "--remove", "--prune"]
    }
  ],
  "options": [
    {
      "name": "--threshold",
      "synopsis": "--threshold=N",
      "kind": "value",
      "group": "Running",
      "value": "N",
      "choices": [],
      "help": "The score a run must reach, from 0 to 100; 80 unless set",
      "commands": ["run"],
      "environment": "",
      "maven": { "property": "-Dmutastic.threshold", "setting": "<threshold>…</threshold>" },
      "gradle": { "property": "-Pmutastic.threshold", "setting": "threshold = …" },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.threshold=70", "maven": "mvn mutastic:run -Dmutastic.threshold=70", "commandLine": "mutastic run --threshold=70", "gradleBuild": "mutastic {\n    threshold = 70\n}", "mavenBuild": "<configuration>\n  <threshold>70</threshold>\n</configuration>" }
    },
    {
      "name": "--since",
      "synopsis": "--since[=REF]",
      "kind": "optional_value",
      "group": "Running",
      "value": "REF",
      "choices": [],
      "help": "Mutate only the lines changed since REF; the default branch without one",
      "commands": ["run"],
      "environment": "",
      "maven": { "property": "-Dmutastic.since", "setting": "<since>…</since>" },
      "gradle": { "property": "-Pmutastic.since", "setting": "since = …" },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.since=main", "maven": "mvn mutastic:run -Dmutastic.since=main", "commandLine": "mutastic run --since=main", "gradleBuild": "mutastic {\n    since = \"main\"\n}", "mavenBuild": "<configuration>\n  <since>main</since>\n</configuration>" }
    },
    {
      "name": "--only",
      "synopsis": "--only=ID",
      "kind": "value",
      "group": "Running",
      "value": "ID",
      "choices": [],
      "help": "Run one mutant; the run passes when it's caught",
      "commands": ["run"],
      "environment": "",
      "maven": { "property": "-Dmutastic.only", "setting": null },
      "gradle": { "property": "-Pmutastic.only", "setting": null },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.only=m855c8e3c", "maven": "mvn mutastic:run -Dmutastic.only=m855c8e3c", "commandLine": "mutastic run --only=m855c8e3c", "gradleBuild": "", "mavenBuild": "" }
    },
    {
      "name": "--tests-from",
      "synopsis": "--tests-from=MODULE",
      "kind": "repeated",
      "group": "Running",
      "value": "MODULE",
      "choices": [],
      "help": "Also run this module's tests over what this one's miss: :app, or dependents for every module that depends on it",
      "commands": ["explain", "run", "verify"],
      "environment": "",
      "maven": { "property": "-Dmutastic.testsFrom", "setting": "<testsFrom>…</testsFrom>" },
      "gradle": { "property": "-Pmutastic.testsFrom", "setting": "testsFrom = …" },
      "examples": { "gradle": "./gradlew :core:mutasticRun -Pmutastic.testsFrom=dependents", "maven": "mvn mutastic:run -Dmutastic.testsFrom=dependents -pl core", "commandLine": "mutastic run . :core --tests-from=dependents", "gradleBuild": "mutastic {\n    testsFrom = listOf(\"dependents\")\n}", "mavenBuild": "<configuration>\n  <testsFrom>\n    <module>dependents</module>\n  </testsFrom>\n</configuration>" }
    },
    {
      "name": "--workers",
      "synopsis": "--workers=N",
      "kind": "value",
      "group": "Running",
      "value": "N",
      "choices": [],
      "help": "How many workers run side by side; half the cores, from 1 to 4, unless set",
      "commands": ["explain", "run", "verify"],
      "environment": "",
      "maven": { "property": "-Dmutastic.workers", "setting": "<workers>…</workers>" },
      "gradle": { "property": "-Pmutastic.workers", "setting": "workers = …" },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.workers=2", "maven": "mvn mutastic:run -Dmutastic.workers=2", "commandLine": "mutastic run --workers=2", "gradleBuild": "mutastic {\n    workers = 2\n}", "mavenBuild": "<configuration>\n  <workers>2</workers>\n</configuration>" }
    },
    {
      "name": "--confirm-catches",
      "synopsis": "--confirm-catches",
      "kind": "flag",
      "group": "Running",
      "value": "",
      "choices": [],
      "help": "Run each catching test again on its own, to confirm the catch",
      "commands": ["explain", "run", "verify"],
      "environment": "",
      "maven": { "property": "-Dmutastic.confirmCatches", "setting": "<confirmCatches>true</confirmCatches>" },
      "gradle": { "property": "-Pmutastic.confirmCatches", "setting": "confirmCatches = true" },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.confirmCatches", "maven": "mvn mutastic:run -Dmutastic.confirmCatches", "commandLine": "mutastic run --confirm-catches", "gradleBuild": "mutastic {\n    confirmCatches = true\n}", "mavenBuild": "<configuration>\n  <confirmCatches>true</confirmCatches>\n</configuration>" }
    },
    {
      "name": "--no-suggestions",
      "synopsis": "--no-suggestions",
      "kind": "flag",
      "group": "Running",
      "value": "",
      "choices": [],
      "help": "Don't look for a test to suggest for each missed mutant",
      "commands": ["explain", "run"],
      "environment": "",
      "maven": { "property": "-Dmutastic.suggestions", "setting": "<suggestions>false</suggestions>" },
      "gradle": { "property": "-Pmutastic.suggestions", "setting": "suggestions = false" },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.suggestions=false", "maven": "mvn mutastic:run -Dmutastic.suggestions=false", "commandLine": "mutastic run --no-suggestions", "gradleBuild": "mutastic {\n    suggestions = false\n}", "mavenBuild": "<configuration>\n  <suggestions>false</suggestions>\n</configuration>" }
    },
    {
      "name": "--operators",
      "synopsis": "--operators=OPERATORS",
      "kind": "repeated",
      "group": "Running",
      "value": "OPERATORS",
      "choices": [],
      "help": "Which operators run: defaults or stronger, an operator's id or namespace, or any with - in front to leave it out; defaults unless set",
      "commands": ["run"],
      "environment": "",
      "maven": { "property": "-Dmutastic.operators", "setting": null },
      "gradle": { "property": "-Pmutastic.operators", "setting": null },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.operators=stronger", "maven": "mvn mutastic:run -Dmutastic.operators=stronger", "commandLine": "mutastic run --operators=stronger", "gradleBuild": "", "mavenBuild": "" }
    },
    {
      "name": "--report",
      "synopsis": "--report=KIND[:PATH]",
      "kind": "repeated",
      "group": "Running",
      "value": "KIND[:PATH]",
      "choices": [],
      "help": "A report file a full run writes: json, html or xml, or none; json and html unless set",
      "commands": ["run"],
      "environment": "",
      "maven": { "property": "-Dmutastic.reports", "setting": "<reports>…</reports>" },
      "gradle": { "property": "-Pmutastic.reports", "setting": "reports = …" },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.reports=xml", "maven": "mvn mutastic:run -Dmutastic.reports=xml", "commandLine": "mutastic run --report=xml", "gradleBuild": "mutastic {\n    reports = listOf(\"xml\")\n}", "mavenBuild": "<configuration>\n  <reports>\n    <report>xml</report>\n  </reports>\n</configuration>" }
    },
    {
      "name": "--format",
      "synopsis": "--format=FORMAT",
      "kind": "value",
      "group": "Output",
      "value": "FORMAT",
      "choices": ["full", "brief", "concise", "grouped", "agent", "jsonl"],
      "help": "How the result is shown; full on a terminal, concise elsewhere, agent for coding agents",
      "commands": ["run"],
      "environment": "MUTASTIC_FORMAT, MUTASTIC_AGENT",
      "maven": { "property": "-Dmutastic.format", "setting": "<format>…</format>" },
      "gradle": { "property": "-Pmutastic.format", "setting": "format = …" },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.format=agent", "maven": "mvn mutastic:run -Dmutastic.format=agent", "commandLine": "mutastic run --format=agent", "gradleBuild": "mutastic {\n    format = \"agent\"\n}", "mavenBuild": "<configuration>\n  <format>agent</format>\n</configuration>" }
    },
    {
      "name": "--vocabulary",
      "synopsis": "--vocabulary=WORDS",
      "kind": "value",
      "group": "Output",
      "value": "WORDS",
      "choices": ["plain", "classic"],
      "help": "plain says caught and missed; classic says killed and survived",
      "commands": ["explain", "run"],
      "environment": "MUTASTIC_VOCABULARY",
      "maven": { "property": "-Dmutastic.vocabulary", "setting": null },
      "gradle": { "property": "-Pmutastic.vocabulary", "setting": null },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.vocabulary=classic", "maven": "mvn mutastic:run -Dmutastic.vocabulary=classic", "commandLine": "mutastic run --vocabulary=classic", "gradleBuild": "", "mavenBuild": "" }
    },
    {
      "name": "--color",
      "synopsis": "--color=WHEN",
      "kind": "value",
      "group": "Output",
      "value": "WHEN",
      "choices": ["auto", "always", "never"],
      "help": "Colour: auto uses it on a terminal that wants it",
      "commands": ["explain", "run"],
      "environment": "NO_COLOR, FORCE_COLOR",
      "maven": { "property": "-Dmutastic.color", "setting": null },
      "gradle": { "property": "-Pmutastic.color", "setting": null },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.color=never", "maven": "mvn mutastic:run -Dmutastic.color=never", "commandLine": "mutastic run --color=never", "gradleBuild": "", "mavenBuild": "" }
    },
    {
      "name": "--hyperlinks",
      "synopsis": "--hyperlinks=WHEN",
      "kind": "value",
      "group": "Output",
      "value": "WHEN",
      "choices": ["auto", "always", "never"],
      "help": "File locations as links a terminal can open: auto uses them on a terminal",
      "commands": ["explain", "run"],
      "environment": "",
      "maven": { "property": "-Dmutastic.hyperlinks", "setting": null },
      "gradle": { "property": "-Pmutastic.hyperlinks", "setting": null },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.hyperlinks=never", "maven": "mvn mutastic:run -Dmutastic.hyperlinks=never", "commandLine": "mutastic run --hyperlinks=never", "gradleBuild": "", "mavenBuild": "" }
    },
    {
      "name": "--progress",
      "synopsis": "--progress=STYLE",
      "kind": "value",
      "group": "Output",
      "value": "STYLE",
      "choices": ["auto", "bar", "counter", "none"],
      "help": "Progress on stderr: a bar on a terminal, counter lines in logs, none for agents",
      "commands": ["explain", "run", "verify"],
      "environment": "",
      "maven": { "property": "-Dmutastic.progress", "setting": null },
      "gradle": { "property": "-Pmutastic.progress", "setting": null },
      "examples": { "gradle": "./gradlew mutasticRun -Pmutastic.progress=counter", "maven": "mvn mutastic:run -Dmutastic.progress=counter", "commandLine": "mutastic run --progress=counter", "gradleBuild": "", "mavenBuild": "" }
    },
    {
      "name": "--reason",
      "synopsis": "--reason=WHY",
      "kind": "value",
      "group": "Ignoring",
      "value": "WHY",
      "choices": [],
      "help": "Why the mutant isn't worth a test: every ignore says",
      "commands": ["ignore"],
      "environment": "",
      "maven": { "property": "-Dmutastic.reason", "setting": null },
      "gradle": { "property": "-Pmutastic.reason", "setting": null },
      "examples": { "gradle": "./gradlew mutasticIgnore -Pmutastic.mutant=m855c8e3c -Pmutastic.reason=\"only logs\"", "maven": "mvn mutastic:ignore -Dmutastic.mutant=m855c8e3c -Dmutastic.reason=\"only logs\"", "commandLine": "mutastic ignore m855c8e3c --reason=\"only logs\"", "gradleBuild": "", "mavenBuild": "" }
    },
    {
      "name": "--remove",
      "synopsis": "--remove",
      "kind": "flag",
      "group": "Ignoring",
      "value": "",
      "choices": [],
      "help": "Take the mutant's ignore away, so it runs again",
      "commands": ["ignore"],
      "environment": "",
      "maven": { "property": "-Dmutastic.remove", "setting": null },
      "gradle": { "property": "-Pmutastic.remove", "setting": null },
      "examples": { "gradle": "./gradlew mutasticIgnore -Pmutastic.mutant=m855c8e3c -Pmutastic.remove", "maven": "mvn mutastic:ignore -Dmutastic.mutant=m855c8e3c -Dmutastic.remove", "commandLine": "mutastic ignore --remove m855c8e3c", "gradleBuild": "", "mavenBuild": "" }
    },
    {
      "name": "--prune",
      "synopsis": "--prune",
      "kind": "flag",
      "group": "Ignoring",
      "value": "",
      "choices": [],
      "help": "Take away every ignore whose code has changed",
      "commands": ["ignore"],
      "environment": "",
      "maven": { "property": "-Dmutastic.prune", "setting": null },
      "gradle": { "property": "-Pmutastic.prune", "setting": null },
      "examples": { "gradle": "./gradlew mutasticIgnore -Pmutastic.prune", "maven": "mvn mutastic:ignore -Dmutastic.prune", "commandLine": "mutastic ignore --prune", "gradleBuild": "", "mavenBuild": "" }
    }
  ],
  "environment": [
    { "name": "MUTASTIC_FORMAT", "meaning": "The format when --format isn't given", "detail": "For a machine or a CI job that always wants the same format, `concise` say." },
    { "name": "MUTASTIC_AGENT=1", "meaning": "The agent format, for coding agents", "detail": "Coding agents set it, so mutastic answers in the format they read best. `MUTASTIC_FORMAT` still wins." },
    { "name": "MUTASTIC_VOCABULARY", "meaning": "plain or classic, when --vocabulary isn't given", "detail": "`classic` says killed and survived instead of caught and missed. The JSON report and the event stream always use the standard names." },
    { "name": "MUTASTIC_PILLS", "meaning": "Labels: square (the default), rounded (for a Nerd Font) or off", "detail": "How labels such as MISSED and PASS are drawn. `rounded` needs a terminal font with Nerd Font glyphs; `off` leaves out the coloured blocks and keeps the words." },
    { "name": "MUTASTIC_ARID=audit", "meaning": "Run the mutants the arid filters skip, and say what happened", "detail": "Adds an Arid audit row to the summary: how many of those mutants ran, and how many the tests caught." },
    { "name": "NO_COLOR", "meaning": "No colour", "detail": "Set to anything, it turns colour off, as it does for many tools." },
    { "name": "FORCE_COLOR", "meaning": "Colour even off a terminal", "detail": "Set to anything, it turns colour on where mutastic can't tell a person is reading, such as a CI log that shows colour." }
  ],
  "exitCodes": [
    { "name": "0", "meaning": "The score reaches the threshold; for verify, the mutant is caught", "detail": "" },
    { "name": "1", "meaning": "The score is below the threshold; for verify, the mutant is still missed", "detail": "" },
    { "name": "2", "meaning": "A usage error, or a build mutastic couldn't read", "detail": "" },
    { "name": "3", "meaning": "The tests fail without any mutant", "detail": "" },
    { "name": "4", "meaning": "mutastic itself went wrong", "detail": "" }
  ]
}
