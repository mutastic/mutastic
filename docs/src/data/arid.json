{
  "schema": "mutastic.arid/v1",
  "page": "https://docs.mutastic.io/reference/arid/",
  "rules": [
    {
      "id": "mutastic:trivial-accessors",
      "anchor": "trivial-accessors",
      "url": "https://docs.mutastic.io/reference/arid/#trivial-accessors",
      "editions": [
        "java"
      ],
      "scope": "method",
      "description": "A getter or setter that only reads or writes one of its class's fields.",
      "reasons": {
        "java": [
          "arid: trivial getter of <field>",
          "arid: trivial setter of <field>"
        ]
      },
      "examples": {
        "java": "String getName() { return name; }"
      },
      "mutate": "arid: [mutastic:trivial-accessors]",
      "annotation": "@DoMutate(arid = \"mutastic:trivial-accessors\")"
    },
    {
      "id": "mutastic:debug-representations",
      "anchor": "debug-representations",
      "url": "https://docs.mutastic.io/reference/arid/#debug-representations",
      "editions": [
        "java"
      ],
      "scope": "method",
      "description": "`toString()` and `hashCode()`, the lambdas they define and the helpers only they call.",
      "reasons": {
        "java": [
          "arid: `toString()` is a debug representation",
          "arid: `hashCode()` may return any value consistent with `equals()`",
          "arid: a lambda in `<method>()`",
          "arid: `<helper>()` only serves `<method>()`"
        ]
      },
      "examples": {
        "java": "public String toString() { return \"Order \" + id; }"
      },
      "mutate": "arid: [mutastic:debug-representations]",
      "annotation": "@DoMutate(arid = \"mutastic:debug-representations\")"
    },
    {
      "id": "mutastic:output",
      "anchor": "output",
      "url": "https://docs.mutastic.io/reference/arid/#output",
      "editions": [
        "java",
        "rust"
      ],
      "scope": "site",
      "description": "Code that only writes output: a log line, or text printed to the console.",
      "reasons": {
        "java": [
          "arid: only writes output"
        ],
        "rust": [
          "arid: only writes output"
        ]
      },
      "examples": {
        "java": "System.out.println(\"Saved \" + id);",
        "rust": "println!(\"saved {id}\");"
      },
      "mutate": "arid: [mutastic:output]",
      "annotation": "@DoMutate(arid = \"mutastic:output\")"
    },
    {
      "id": "mutastic:messages",
      "anchor": "messages",
      "url": "https://docs.mutastic.io/reference/arid/#messages",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "The text of an exception's message, or of a failed check's.",
      "reasons": {
        "java": [
          "arid: only an exception's message",
          "arid: only a failed check's message"
        ]
      },
      "examples": {
        "java": "throw new IllegalArgumentException(\"amount must be positive\");"
      },
      "mutate": "arid: [mutastic:messages]",
      "annotation": "@DoMutate(arid = \"mutastic:messages\")"
    },
    {
      "id": "mutastic:failed-asserts",
      "anchor": "failed-asserts",
      "url": "https://docs.mutastic.io/reference/arid/#failed-asserts",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "The `throw` of an `assert` that fails.",
      "reasons": {
        "java": [
          "arid: only says an assert failed"
        ]
      },
      "examples": {
        "java": "assert total >= 0 : \"negative total\";"
      },
      "mutate": "arid: [mutastic:failed-asserts]",
      "annotation": "@DoMutate(arid = \"mutastic:failed-asserts\")"
    },
    {
      "id": "mutastic:capacity",
      "anchor": "capacity",
      "url": "https://docs.mutastic.io/reference/arid/#capacity",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "The size a collection or a buffer starts with.",
      "reasons": {
        "java": [
          "arid: only sizes a collection's first allocation"
        ]
      },
      "examples": {
        "java": "new ArrayList<>(orders.size() * 2)"
      },
      "mutate": "arid: [mutastic:capacity]",
      "annotation": "@DoMutate(arid = \"mutastic:capacity\")"
    },
    {
      "id": "mutastic:wait-times",
      "anchor": "wait-times",
      "url": "https://docs.mutastic.io/reference/arid/#wait-times",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "How long a sleep, or a `join` with a time limit, waits.",
      "reasons": {
        "java": [
          "arid: only sets how long to wait"
        ]
      },
      "examples": {
        "java": "Thread.sleep(seconds * 1000L);"
      },
      "mutate": "arid: [mutastic:wait-times]",
      "annotation": "@DoMutate(arid = \"mutastic:wait-times\")"
    },
    {
      "id": "mutastic:waits",
      "anchor": "waits",
      "url": "https://docs.mutastic.io/reference/arid/#waits",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "A sleep removed: `Thread.sleep` or `TimeUnit.sleep`.",
      "reasons": {
        "java": [
          "arid: only waits"
        ]
      },
      "examples": {
        "java": "Thread.sleep(100);"
      },
      "mutate": "arid: [mutastic:waits]",
      "annotation": "@DoMutate(arid = \"mutastic:waits\")"
    },
    {
      "id": "mutastic:null-checks",
      "anchor": "null-checks",
      "url": "https://docs.mutastic.io/reference/arid/#null-checks",
      "editions": [
        "java",
        "rust"
      ],
      "scope": "site",
      "description": "A call that only checks a value is there, its result unused, removed: `Objects.requireNonNull(x)` or `x.getClass()` in Java, `x.unwrap()` or `x.expect(…)` in Rust.",
      "reasons": {
        "java": [
          "arid: only checks the value isn't null"
        ],
        "rust": [
          "arid: only checks the value is there"
        ]
      },
      "examples": {
        "java": "Objects.requireNonNull(order);",
        "rust": "order.unwrap();"
      },
      "mutate": "arid: [mutastic:null-checks]",
      "annotation": "@DoMutate(arid = \"mutastic:null-checks\")"
    },
    {
      "id": "mutastic:array-sizes",
      "anchor": "array-sizes",
      "url": "https://docs.mutastic.io/reference/arid/#array-sizes",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "The size of a new array, written as a number.",
      "reasons": {
        "java": [
          "arid: only sizes an array"
        ]
      },
      "examples": {
        "java": "byte[] buffer = new byte[8192];"
      },
      "mutate": "arid: [mutastic:array-sizes]",
      "annotation": "@DoMutate(arid = \"mutastic:array-sizes\")"
    },
    {
      "id": "mutastic:first-values",
      "anchor": "first-values",
      "url": "https://docs.mutastic.io/reference/arid/#first-values",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "A variable's first value of 0 or 1, where a counter or a total starts.",
      "reasons": {
        "java": [
          "arid: a variable's first value of 0 or 1"
        ]
      },
      "examples": {
        "java": "int count = 0;"
      },
      "mutate": "arid: [mutastic:first-values]",
      "annotation": "@DoMutate(arid = \"mutastic:first-values\")"
    },
    {
      "id": "mutastic:split-limits",
      "anchor": "split-limits",
      "url": "https://docs.mutastic.io/reference/arid/#split-limits",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "The limit of a `String.split`.",
      "reasons": {
        "java": [
          "arid: only limits a split"
        ]
      },
      "examples": {
        "java": "line.split(\",\", 2)"
      },
      "mutate": "arid: [mutastic:split-limits]",
      "annotation": "@DoMutate(arid = \"mutastic:split-limits\")"
    },
    {
      "id": "mutastic:thread-names",
      "anchor": "thread-names",
      "url": "https://docs.mutastic.io/reference/arid/#thread-names",
      "editions": [
        "java",
        "rust"
      ],
      "scope": "site",
      "description": "A thread's or a pool's name, which only people and their tools read: a thread dump, a profiler, a log pattern.",
      "reasons": {
        "java": [
          "arid: only names a thread"
        ],
        "rust": [
          "arid: only names a thread"
        ]
      },
      "examples": {
        "java": "thread.setName(\"background-task\");",
        "rust": "let builder = thread::Builder::new().name(\"squarer\".into());"
      },
      "mutate": "arid: [mutastic:thread-names]",
      "annotation": "@DoMutate(arid = \"mutastic:thread-names\")"
    },
    {
      "id": "mutastic:thread-priorities",
      "anchor": "thread-priorities",
      "url": "https://docs.mutastic.io/reference/arid/#thread-priorities",
      "editions": [
        "java"
      ],
      "scope": "site",
      "description": "A thread's priority from 1 to 10: a hint, which Linux ignores by default and a virtual thread always does.",
      "reasons": {
        "java": [
          "arid: only sets a priority hint"
        ]
      },
      "examples": {
        "java": "thread.setPriority(Thread.MAX_PRIORITY);"
      },
      "mutate": "arid: [mutastic:thread-priorities]",
      "annotation": "@DoMutate(arid = \"mutastic:thread-priorities\")"
    },
    {
      "id": "mutastic:keep-alive",
      "anchor": "keep-alive",
      "url": "https://docs.mutastic.io/reference/arid/#keep-alive",
      "editions": [
        "java",
        "rust"
      ],
      "scope": "site",
      "description": "How long a pool's idle threads live before they stop, while it stays above zero.",
      "reasons": {
        "java": [
          "arid: only sets how long idle threads live"
        ],
        "rust": [
          "arid: only sets how long idle threads live"
        ]
      },
      "examples": {
        "java": "pool.setKeepAliveTime(30, TimeUnit.SECONDS);",
        "rust": "let runtime = Builder::new_multi_thread().thread_keep_alive(Duration::from_secs(5 * 60));"
      },
      "mutate": "arid: [mutastic:keep-alive-times]",
      "annotation": "@DoMutate(arid = \"mutastic:keep-alive-times\")"
    },
    {
      "id": "mutastic:stack-sizes",
      "anchor": "stack-sizes",
      "url": "https://docs.mutastic.io/reference/arid/#stack-sizes",
      "editions": [
        "java",
        "rust"
      ],
      "scope": "site",
      "description": "The size of a thread's stack, while it stays above zero.",
      "reasons": {
        "java": [
          "arid: only sizes a thread's stack"
        ],
        "rust": [
          "arid: only sizes a thread's stack"
        ]
      },
      "examples": {
        "java": "Thread.ofPlatform().stackSize(1 << 20).unstarted(task);",
        "rust": "let builder = thread::Builder::new().stack_size(64 * 1024);"
      },
      "mutate": "arid: [mutastic:stack-sizes]",
      "annotation": "@DoMutate(arid = \"mutastic:stack-sizes\")"
    }
  ]
}
